{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["packages/service/src/waves.ts:95-140", "packages/service/src/waves.ts:251-292"],
  "vitest": {
    "configFile": "vitest.closing.config.ts"
  },
  "reporters": ["clear-text", "json"],
  "jsonReporter": {
    "fileName": "reports/mutants-closing.json"
  },
  "coverageAnalysis": "perTest",
  "concurrency": 2,
  "timeoutMS": 60000,
  "thresholds": {
    "high": 90,
    "low": 85,
    "break": 85
  }
}
